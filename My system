## 8. `routes/auth.routes.js`
*Login, logout, session check*

````javascript
/** Login, logout and session check */
const express = require("express");
const { db, audit } = require("../database");
const {
  auth,
  startSession,
  endSession,
  publicUser,
} = require("../middleware/auth");
const { verify } = require("../utils/helpers");

const router = express.Router();

router.post("/api/login", (q, s) => {
  const id = String(q.body.id || "")
      .trim()
      .toUpperCase(),
    pw = String(q.body.pw || ""),
    role = q.body.role;
  const bad = (m, c = 401) => s.status(c).json({ error: m });
  if (!id || !pw) return bad("Enter your staff ID and password.", 400);
  const u = db.prepare("SELECT * FROM users WHERE staff_id=?").get(id);
  if (!u)
    return bad("Staff ID or password is incorrect. Check both and try again.");
  if (!u.is_active)
    return bad(
      "This account is locked or deactivated. Contact the system administrator.",
      403,
    );
  if (!verify(pw, u.password_hash)) {
    const f = u.failed_attempts + 1;
    db.prepare(
      "UPDATE users SET failed_attempts=?,is_active=? WHERE user_id=?",
    ).run(f, f >= 3 ? 0 : 1, u.user_id);
    return f >= 3
      ? bad(
          "Too many failed attempts. Account locked; contact the system administrator.",
          403,
        )
      : bad(`Staff ID or password is incorrect. ${3 - f} attempt(s) left.`);
  }
  if (u.role !== role)
    return bad(
      `This account is not registered as ${role}. Select the correct role.`,
      403,
    );
  db.prepare("UPDATE users SET failed_attempts=0 WHERE user_id=?").run(
    u.user_id,
  );
  startSession(s, u.user_id);
  audit(u.user_id, "Logged in", "—");
  s.json({ user: publicUser(u) });
});
router.get("/api/me", auth(), (q, s) => s.json({ user: publicUser(q.user) }));
router.post("/api/logout", auth(), (q, s) => {
  audit(q.user.user_id, "Logged out", "—");
  endSession(q, s);
  s.json({ ok: true });
});

module.exports = router;
````

## 9. `routes/records.routes.js`
*LAND RECORDS: search, add, duplicate detection, edit, deed upload*

````javascript
/**
 * Land record routes
 *   GET   /api/records              search / list records
 *   POST  /api/records              add a record (detects duplicates)
 *   PUT   /api/records/:id          edit a record
 *   POST  /api/records/:id/view     log that a record was opened
 *   POST  /api/records/:id/deed     upload / replace the scanned title deed
 *   POST  /api/certificate/:title   log certificate generation
 */
const express = require("express");
const path = require("path");
const { db, audit } = require("../database");
const { auth } = require("../middleware/auth");
const { upload } = require("../middleware/upload");
const { dmy, today } = require("../utils/helpers");

const router = express.Router();

/* ---------- Shared query + row mapper ---------- */
const SELECT_RECORDS = `
  SELECT r.*, u.staff_id
  FROM land_records r
  JOIN users u ON u.user_id = r.created_by`;

function toRecord(r) {
  return {
    id: r.record_id,
    title: r.title_number,
    owner: r.owner_name,
    nid: r.national_id,
    size: r.parcel_size,
    loc: r.location,
    use: r.land_use,
    date: dmy(r.registration_date),
    deed: r.deed_path ? path.basename(r.deed_path).replace(/^\d+_/, "") : "",
    status: r.status,
    by: r.staff_id,
  };
}

const findRecord = (id) =>
  db.prepare("SELECT * FROM land_records WHERE record_id = ?").get(id);

/* ---------- Search / list ---------- */
router.get("/api/records", auth(), (req, res) => {
  const term = `%${String(req.query.q || "").trim()}%`;
  const rows = db
    .prepare(
      `${SELECT_RECORDS}
       WHERE r.title_number LIKE ? OR r.owner_name LIKE ?
          OR r.national_id LIKE ? OR r.location LIKE ?
       ORDER BY r.record_id`,
    )
    .all(term, term, term, term);

  res.json({ records: rows.map(toRecord) });
});

/* ---------- Add a new record ---------- */
router.post("/api/records", auth(), upload.single("deed"), (req, res) => {
  const b = req.body;
  const title = String(b.title || "")
    .trim()
    .toUpperCase();
  const fail = (msg) => res.status(400).json({ error: msg });

  // 1. Validation
  if (!b.owner || !b.nid || !title || !b.size || !b.loc)
    return fail(
      "Fill in owner name, national ID, title number, parcel size and location.",
    );
  if (!/^\d{7,8}$/.test(b.nid))
    return fail("National ID must be 7 or 8 digits.");
  if (!/^[A-Z]{3}\/\d{1,5}\/\d{4}$/.test(title))
    return fail("Title number must look like NAK/1234/2026.");
  if (!(+b.size > 0)) return fail("Parcel size must be more than 0 acres.");

  // 2. Duplicate detection: does this title number already exist?
  const isDuplicate =
    db
      .prepare(
        "SELECT COUNT(*) c FROM land_records WHERE upper(title_number) = ?",
      )
      .get(title).c > 0;

  // 3. Save (a duplicate is stored but flagged, never silently rejected)
  const result = db
    .prepare(
      `INSERT INTO land_records
         (title_number, owner_name, national_id, parcel_size, location,
          land_use, registration_date, deed_path, status, created_by)
       VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?)`,
    )
    .run(
      title,
      b.owner.trim(),
      b.nid,
      +b.size,
      b.loc.trim(),
      b.use || "Residential",
      today(),
      req.file ? "uploads/" + req.file.filename : null,
      isDuplicate ? "DUPLICATE" : "Active",
      req.user.user_id,
    );

  // 4. Audit trail
  const recordId = result.lastInsertRowid;
  audit(req.user.user_id, "Created new record", title, recordId);
  if (isDuplicate)
    audit(req.user.user_id, "Duplicate flagged", title, recordId);

  res.json({ id: recordId, duplicate: isDuplicate });
});

/* ---------- Edit a record ---------- */
router.put("/api/records/:id", auth(), (req, res) => {
  const record = findRecord(req.params.id);
  const b = req.body;

  if (!record) return res.status(404).json({ error: "Record not found." });
  if (
    !b.owner ||
    !b.loc ||
    !(+b.size > 0) ||
    !["Active", "DUPLICATE"].includes(b.status)
  )
    return res
      .status(400)
      .json({ error: "Owner, location and a size above 0 are required." });

  db.prepare(
    `UPDATE land_records
     SET owner_name = ?, location = ?, parcel_size = ?, status = ?
     WHERE record_id = ?`,
  ).run(b.owner.trim(), b.loc.trim(), +b.size, b.status, record.record_id);

  audit(
    req.user.user_id,
    "Edited record",
    record.title_number,
    record.record_id,
  );
  res.json({ ok: true });
});

/* ---------- Log a record view ---------- */
router.post("/api/records/:id/view", auth(), (req, res) => {
  const record = findRecord(req.params.id);
  if (record)
    audit(
      req.user.user_id,
      "Viewed record",
      record.title_number,
      record.record_id,
    );
  res.json({ ok: true });
});

/* ---------- Upload title deed ---------- */
router.post(
  "/api/records/:id/deed",
  auth(),
  upload.single("deed"),
  (req, res) => {
    const record = findRecord(req.params.id);
    if (!record || !req.file)
      return res.status(400).json({ error: "Choose a record and a file." });

    db.prepare("UPDATE land_records SET deed_path = ? WHERE record_id = ?").run(
      "uploads/" + req.file.filename,
      record.record_id,
    );
    audit(
      req.user.user_id,
      "Uploaded title deed",
      record.title_number,
      record.record_id,
    );
    res.json({ ok: true });
  },
);

/* ---------- Ownership certificate (only Active records qualify) ---------- */
router.post("/api/certificate/:title", auth(), (req, res) => {
  const record = db
    .prepare(
      "SELECT * FROM land_records WHERE upper(title_number) = upper(?) AND status = 'Active'",
    )
    .get(req.params.title);

  if (!record)
    return res
      .status(404)
      .json({ error: "No active record found for that title number." });

  audit(
    req.user.user_id,
    "Generated certificate",
    record.title_number,
    record.record_id,
  );
  res.json({ ok: true });
});

module.exports = router;
````

## 10. `routes/admin.routes.js`
*Audit trail, user accounts, database viewer*

````javascript
/** Administrator routes: audit trail, user accounts, database viewer */
const express = require("express");
const { db, audit, DB_PATH } = require("../database");
const { auth } = require("../middleware/auth");
const { RO, AD, hash } = require("../utils/helpers");

const router = express.Router();

/* admin */
router.get("/api/audit", auth(AD), (q, s) =>
  s.json({
    audit: db
      .prepare(
        "SELECT a.logged_at,u.staff_id,u.full_name,a.action,a.record_ref FROM audit_log a JOIN users u ON u.user_id=a.user_id ORDER BY a.log_id DESC",
      )
      .all()
      .map((a) => ({
        ts: a.logged_at.replace(" ", "T"),
        user: `${a.staff_id} ${a.full_name.replace(". ", ".")}`,
        action: a.action,
        ref: a.record_ref,
      })),
  }),
);
router.get("/api/users", auth(AD), (q, s) =>
  s.json({
    users: db
      .prepare(
        "SELECT user_id,staff_id,full_name,role,is_active FROM users ORDER BY user_id",
      )
      .all()
      .map((u) => ({
        uid: u.user_id,
        id: u.staff_id,
        name: u.full_name,
        role: u.role,
        active: !!u.is_active,
      })),
  }),
);
router.post("/api/users", auth(AD), (q, s) => {
  const b = q.body,
    id = String(b.id || "")
      .trim()
      .toUpperCase();
  if (
    !id ||
    !b.name ||
    String(b.pw || "").length < 8 ||
    ![RO, AD].includes(b.role)
  )
    return s
      .status(400)
      .json({
        error:
          "Enter a staff ID, a name and a password of at least 8 characters.",
      });
  if (db.prepare("SELECT 1 FROM users WHERE staff_id=?").get(id))
    return s.status(409).json({ error: "That staff ID already exists." });
  db.prepare(
    "INSERT INTO users(staff_id,full_name,password_hash,role) VALUES(?,?,?,?)",
  ).run(id, b.name.trim(), hash(b.pw), b.role);
  audit(q.user.user_id, "Created account", id);
  s.json({ ok: true });
});
router.post("/api/users/:uid/toggle", auth(AD), (q, s) => {
  const u = db.prepare("SELECT * FROM users WHERE user_id=?").get(q.params.uid);
  if (!u || u.user_id === q.user.user_id)
    return s.status(400).json({ error: "You cannot change this account." });
  const a = u.is_active ? 0 : 1;
  db.prepare(
    "UPDATE users SET is_active=?,failed_attempts=0 WHERE user_id=?",
  ).run(a, u.user_id);
  audit(
    q.user.user_id,
    a ? "Activated account" : "Deactivated account",
    u.staff_id,
  );
  s.json({ ok: true });
});

/* database viewer (admin only): every table, its SQL and its rows; password hashes hidden */
router.get("/api/db", auth(AD), (q, s) => {
  const tables = db
    .prepare(
      "SELECT name,sql FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' ORDER BY rowid",
    )
    .all()
    .map((t) => {
      const cols = db
          .prepare(`PRAGMA table_info(${t.name})`)
          .all()
          .map((c) => c.name),
        rows = db.prepare(`SELECT * FROM ${t.name} LIMIT 500`).all();
      rows.forEach((r) => {
        if ("password_hash" in r) r.password_hash = "(hashed)";
      });
      return {
        name: t.name,
        sql: t.sql,
        cols,
        rows,
        count: db.prepare(`SELECT COUNT(*) c FROM ${t.name}`).get().c,
      };
    });
  s.json({ tables });
});
router.get("/api/db/download", auth(AD), (q, s) =>
  s.download(DB_PATH, "landtrust.db"),
);

module.exports = router;
````

