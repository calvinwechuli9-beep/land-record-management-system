  shell();
}
const pill = (s) =>
  `<span class="pill ${s === "Active" ? "" : s === "DUPLICATE" ? "dup" : "off"}">${s}</span>`;

function dash() {
  const d = db.recs.filter((r) => r.status === "DUPLICATE").length;
