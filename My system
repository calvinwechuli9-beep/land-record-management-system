## 5. `utils/helpers.js`
*Password hashing, date formatting, role names*

````javascript
const crypto = require("crypto");

const RO = "Records Officer";
const AD = "Administrator";
const MONTHS = [
  "Jan",
  "Feb",
  "Mar",
  "Apr",
  "May",
  "Jun",
  "Jul",
  "Aug",
  "Sep",
  "Oct",
  "Nov",
  "Dec",
];

/* ---------- Password hashing (salted scrypt) ---------- */
function hash(password) {
  const salt = crypto.randomBytes(16).toString("hex");
  return salt + ":" + crypto.scryptSync(password, salt, 64).toString("hex");
}

function verify(password, stored) {
  const [salt, key] = stored.split(":");
  return crypto.timingSafeEqual(
    Buffer.from(key, "hex"),
    crypto.scryptSync(password, salt, 64),
  );
}

/* ---------- Dates ---------- */
// "2026-09-23" -> "23-Sep-2026"
function dmy(iso) {
  const [y, m, d] = iso.slice(0, 10).split("-");
  return `${d}-${MONTHS[+m - 1]}-${y}`;
}

// today as "YYYY-MM-DD"
function today() {
  const n = new Date();
  const mm = String(n.getMonth() + 1).padStart(2, "0");
  const dd = String(n.getDate()).padStart(2, "0");
  return `${n.getFullYear()}-${mm}-${dd}`;
}

module.exports = { RO, AD, hash, verify, dmy, today };
````

## 6. `middleware/auth.js`
*Sessions and role-based access guard*

````javascript
const crypto = require("crypto");
const { db } = require("../database");

// sessionId -> user_id (in memory; cleared when the server restarts)
const sessions = new Map();

function sessionId(req) {
  const match = (req.headers.cookie || "").match(/(?:^|; )sid=([a-f0-9]+)/);
  return match && match[1];
}

function startSession(res, userId) {
  const id = crypto.randomBytes(24).toString("hex");
  sessions.set(id, userId);
  res.setHeader("Set-Cookie", `sid=${id}; HttpOnly; SameSite=Strict; Path=/`);
}

function endSession(req, res) {
  sessions.delete(sessionId(req));
  res.setHeader("Set-Cookie", "sid=; Max-Age=0; Path=/");
}

// Route guard. auth() = any logged-in user, auth("Administrator") = admins only
function auth(role) {
  return (req, res, next) => {
    const userId = sessions.get(sessionId(req));
    const user =
      userId &&
      db
        .prepare("SELECT * FROM users WHERE user_id = ? AND is_active = 1")
        .get(userId);

    if (!user) return res.status(401).json({ error: "Please log in." });
    if (role && user.role !== role)
      return res.status(403).json({ error: "Administrator access required." });

    req.user = user;
    next();
  };
}

const publicUser = (u) => ({
  uid: u.user_id,
  id: u.staff_id,
  name: u.full_name,
  role: u.role,
});

module.exports = { auth, startSession, endSession, publicUser };
````

